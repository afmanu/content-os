{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-os.onboarding.v1",
  "title": "Content OS configured onboarding profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "configured_at", "updated_at", "answers"],
  "properties": {
    "schema_version": { "const": 1 },
    "status": { "const": "configured" },
    "configured_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "answers": {
      "type": "object",
      "required": ["identity", "purpose", "channels", "voice", "privacy", "tools"],
      "properties": {
        "channels": {
          "type": "object",
          "required": ["active_channels"],
          "properties": {
            "active_channels": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "enum": ["youtube", "linkedin", "x"] }
            }
          }
        },
        "privacy": {
          "type": "object",
          "required": ["sync_status", "private_media_policy", "external_processing", "external_actions_default", "publication_approval"]
        }
      }
    }
  }
}
